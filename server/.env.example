# Port the API listens on
PORT=4000

# MongoDB connection string. Leave blank (or use the sample cluster.mongodb.net/db
# placeholder) to run in in-memory Mock Mode with a demo account:
#   email: demo@nuvosid.design   password: password123
MONGODB_URI=

# Secret used to sign/verify JWTs. MUST match nothing else; make it long & random.
JWT_SECRET=change_this_to_a_long_random_string

# Allowed frontend origin(s) for CORS. Comma-separate multiple.
# Dev example:  http://localhost:3000
# Prod example: https://your-static-site.com
CLIENT_URL=http://localhost:3000
